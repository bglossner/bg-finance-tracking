                    name="transaction_period_date_MM_DD_YYYY"><FULL_MONTH_NAME (i.e. January)> DD, YYYY
            </option>
            <option value="/myaccounts/details/card/download-transactions.go?&amp;adx=<ACCOUNT_TOKEN>&amp;stx=<STATEMENT_ID>&amp;target=downloadStmtFromDateList"
