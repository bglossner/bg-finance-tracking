# Replace /absolute/path placeholders before installing in a user crontab.
SHELL=/bin/sh
PATH=/usr/bin:/bin
BGFIN_DATA_DIR=/absolute/path/to/private-import-data
BGFIN_ENV_FILE=/absolute/path/to/private-import.env
7 * * * * /bin/bash -p /absolute/path/to/bg-finance-tracking/ops/schedule/run-import.sh
